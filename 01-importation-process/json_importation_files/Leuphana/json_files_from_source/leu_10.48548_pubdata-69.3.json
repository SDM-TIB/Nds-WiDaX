    "DataCite": {
        "Description": [
            {
                "value": "This dataset is a register of documents included in an analysis of digital health platform governance sorted in two lists: The first list shows documents regarding Apple Health. The second list focuses on documents from (2) telematics infrastructure with a special view on German healthcare. The register provides author, year, title and referring link to every single document and includes various types of web resources such as laws, statements, guidelines, workflows, reports, articles, etc.",
                "qualifier": "Abstract",
                "lang": "en"
            },
            {
                "value": "Analysis of text documents",
                "qualifier": "Methods"
            },
