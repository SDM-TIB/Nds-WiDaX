    "DataCite": {
        "Description": [
            {
                "value": "This data set provides the supporting material for the publication \"Configuring Production Planning and Control for Remanufacturing Systems: A DMAIC-based Methodology\" including a simulation and various tables. The supplemetary materials consist of the raw data, interview sheets, and the matrices presented in the paper, in detail (1) the structured interview sheet used for company surveys / interviews, (2) data related to the general evaluation of competence for the procedure, (3) detailed explanation of the rating of fulfilment and required competencies, (4) detailed calculations for the suitability matrix, and (5) detailed calculations for the competence matrix.",
                "qualifier": "Abstract",
                "lang": "en"
            },
            {
                "value": "Analysis of text documents",
                "qualifier": "Methods"
            }
